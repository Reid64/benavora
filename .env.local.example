# ============================================================================
# BENAVORA — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. NEVER hardcode these values in source.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase (PostgreSQL + Auth + RLS + Realtime + Storage)
# ----------------------------------------------------------------------------
# Public — safe to expose to the browser (used by client + server SSR clients)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only — service role key. NEVER expose to the client.
# Used ONLY by agents via the admin client (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----------------------------------------------------------------------------
# Anthropic Claude API (AI drafting, summarization, scoring, learning)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key
# Default model — can be overridden per-org via platform_config (ai.model)
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# ----------------------------------------------------------------------------
# OpenAI (Grant Intelligence Library — embeddings only)
# ----------------------------------------------------------------------------
# Required for Grant Intelligence Library embeddings (text-embedding-3-small)
OPENAI_API_KEY=your-openai-api-key

# ----------------------------------------------------------------------------
# LaunchDarkly (feature flags — PIL gradual rollout / killswitch)
# ----------------------------------------------------------------------------
# Server-only SDK key. NEVER expose to the client. Missing key degrades gracefully:
# gated flags evaluate to their fallback (src/lib/feature-flags/ld-client.ts).
LAUNCHDARKLY_SDK_KEY=your-launchdarkly-server-sdk-key

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
# Public base URL of the deployed app (used for auth callbacks, links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Cron / scheduled jobs (Vercel Cron)
# ----------------------------------------------------------------------------
# Shared secret guarding the system cron endpoints (/api/cron/research,
# /api/deadlines/check). Server-only — NEVER expose to the client. Scheduled
# callers must present it as `Authorization: Bearer ${CRON_SECRET}`. Generate a
# long random value (e.g. `openssl rand -hex 32`). Leave unset to disable the
# cron path entirely — the endpoint then rejects every request as unauthorized.
CRON_SECRET=your-long-random-cron-secret

# Shared secret guarding the Prometheus scrape endpoint (/api/metrics).
# Server-only — NEVER expose to the client. Scrapers must present it as
# `Authorization: Bearer ${METRICS_SCRAPE_SECRET}`. Generate a long random
# value (e.g. `openssl rand -hex 32`). Leave unset to disable the metrics
# path entirely — the endpoint then rejects every request as unauthorized.
METRICS_SCRAPE_SECRET=your-long-random-metrics-secret

# Shared secret guarding /api/discovery/pil-trigger, the webhook Discovery
# calls after importing a prospect to hand it off to the Prospect Intelligence
# Layer. Server-only — NEVER expose to the client. Discovery must present it as
# `Authorization: Bearer ${DISCOVERY_WEBHOOK_SECRET}`. Generate a long random
# value (e.g. `openssl rand -hex 32`). Leave unset to disable the endpoint
# entirely — it then rejects every request as unauthorized.
DISCOVERY_WEBHOOK_SECRET=your-long-random-discovery-webhook-secret

# ----------------------------------------------------------------------------
# Phase 4 — Email + Calendar (Gmail / Google Calendar APIs)
# ----------------------------------------------------------------------------
# Set these up in Google Cloud Console BEFORE using the integration:
#   - Enable the Gmail API and Google Calendar API
#   - Create OAuth 2.0 credentials (Web application type)
#   - Authorized redirect URI: {NEXT_PUBLIC_SITE_URL}/api/integrations/google/callback
#   - Scopes: gmail.readonly, gmail.send, gmail.modify, calendar.events
# Server-only — NEVER expose GOOGLE_CLIENT_SECRET to the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in the OAuth client, e.g.
# http://localhost:3000/api/integrations/google/callback
GOOGLE_REDIRECT_URI=

# Symmetric key used to encrypt OAuth tokens at rest in the integrations table
# (Behavioral Contracts §19). Optional: if unset, a key is derived from
# GOOGLE_CLIENT_SECRET so encryption still works out of the box. Set an explicit
# value (e.g. `openssl rand -hex 32`) to decouple token encryption from the
# OAuth client secret. Server-only — NEVER expose to the client.
INTEGRATION_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Phase 5 — Stripe subscription billing
# ----------------------------------------------------------------------------
# Set these up in the Stripe Dashboard BEFORE enabling billing:
#   - Create the secret/publishable API keys (Developers → API keys)
#   - Create a recurring monthly Price for each paid tier and copy its price_...
#     id into the matching *_PRICE_ID var below
#   - Register the webhook endpoint {NEXT_PUBLIC_SITE_URL}/api/webhooks/stripe
#     subscribed to: checkout.session.completed, customer.subscription.updated,
#     customer.subscription.deleted, invoice.payment_succeeded,
#     invoice.payment_failed — then copy its signing secret into
#     STRIPE_WEBHOOK_SECRET.
# Server-only — NEVER expose STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET to the
# client. Only the publishable key is safe in the browser.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PROFESSIONAL_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_CONSULTANT_PRICE_ID=

# ----------------------------------------------------------------------------
# Tailored demo booking (/demo) — Calendly inline embed
# ----------------------------------------------------------------------------
# Public — the visitor-facing scheduling page URL for the /demo flow's
# calendar step (src/app/(marketing)/demo/DemoClient.tsx). Calendly is the
# default choice for launch speed since no custom booking backend has been
# built or decided on — revisit if a custom scheduling system is preferred
# later. Leave unset to show an honest "not configured yet" fallback instead
# of a broken embed; the intake step (POST /api/public/demo) still works and
# stores the request either way.
#   e.g. https://calendly.com/your-org/tailored-demo
NEXT_PUBLIC_CALENDLY_URL=

# ----------------------------------------------------------------------------
# Off-provider database backups (scripts/backup-database.ts -> AWS S3)
# ----------------------------------------------------------------------------
# Direct Postgres connection string (NOT the pooled/PgBouncer one) — pg_dump
# needs a real connection. Supabase: Project Settings -> Database -> Connection
# string -> URI, "Direct connection". Server-only — NEVER expose to the client.
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# IAM credentials for a role/user scoped to PutObject + AbortMultipartUpload
# on the backup bucket only (see infra/aws/backup-bucket/README.md). In
# GitHub Actions, prefer OIDC role assumption over static keys — see
# .github/workflows/backup-database.yml. Server-only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Destination bucket for backups and the region it lives in. Defaults match
# infra/aws/backup-bucket if left unset.
BACKUP_S3_BUCKET=benavora-prod-backups
BACKUP_S3_REGION=us-east-1
