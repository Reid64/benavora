        "seed:beta": "tsx scripts/seed-beta-users.ts",
        "seed:dd-taxonomy": "tsx scripts/seed-dd-taxonomy.ts",
        "seed:dd-aliases": "tsx scripts/seed-dd-aliases.ts",
        "enrich:990": "tsx scripts/enrich-foundations-990.ts",
        "enrich:web": "tsx scripts/enrich-foundations-web.ts",
        "enrich:propublica": "tsx scripts/enrich-nonprofits-propublica.ts",
        "ingest:bmf": "tsx scripts/ingest-irs-bmf-full.ts",
        "ingest:samgov": "tsx scripts/ingest-samgov.ts",
        "ingest:nih-reporter": "tsx scripts/ingest-nih-reporter.ts",
        "ingest:nsf": "tsx scripts/ingest-nsf-awards.ts",
