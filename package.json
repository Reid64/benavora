        "playwright": "^1.60.0",
        "playwright-extra": "^4.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "recharts": "^2.15.4",
        "resend": "^6.12.4",
