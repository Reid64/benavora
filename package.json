{
    "name": "benavora",
    "version": "0.1.0",
    "private": true,
    "description": "Benavora — nonprofit funding automation platform",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "build:worker": "tsc -p worker/tsconfig.json && tsc-alias -p worker/tsconfig.json",
        "start": "next start",
        "lint": "next lint",
        "typecheck": "tsc --noEmit",
        "test": "playwright test --reporter=list",
