        "eslint": "^8.57.1",
        "eslint-config-next": "^14.2.13",
        "pg": "^8.21.0",
        "postcss": "^8.4.47",
        "tailwindcss": "^3.4.12",
        "tsc-alias": "^1.9.0",
        "tsx": "^4.23.0",
        "typescript": "^5.6.2",
        "vitest": "^2.0.0"
