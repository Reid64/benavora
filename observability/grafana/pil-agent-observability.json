{
  "title": "PIL Agent Observability",
  "uid": "pil-agent-observability",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["benavora", "pil", "agents"],
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "label": "Datasource"
      },
      {
        "name": "family",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(benavora_agent_run_duration_seconds_count, family)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "label": "Family"
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Success Rate by Family", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 1 },

    {
      "id": 10,
      "type": "stat",
      "title": "SUP — Supervisory",
      "gridPos": { "h": 4, "w": 2, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(benavora_agent_run_duration_seconds_count{family=\"supervisory\", status=\"completed\"}[5m])) / sum(rate(benavora_agent_run_duration_seconds_count{family=\"supervisory\"}[5m]))"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "DIS — Discovery",
      "gridPos": { "h": 4, "w": 2, "x": 2, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 0.95 }
          ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(benavora_agent_run_duration_seconds_count{family=\"discovery\", status=\"completed\"}[5m])) / sum(rate(benavora_agent_run_duration_seconds_count{family=\"discovery\"}[5m]))"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "INT — Prospect Intelligence",
      "gridPos": { "h": 4, "w": 2, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 0.95 }
          ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(benavora_agent_run_duration_seconds_count{family=\"prospect_intelligence\", status=\"completed\"}[5m])) / sum(rate(benavora_agent_run_duration_seconds_count{family=\"prospect_intelligence\"}[5m]))"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "REL — Relationship Intelligence",
      "gridPos": { "h": 4, "w": 2, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 0.95 }
          ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(benavora_agent_run_duration_seconds_count{family=\"relationship_intelligence\", status=\"completed\"}[5m])) / sum(rate(benavora_agent_run_duration_seconds_count{family=\"relationship_intelligence\"}[5m]))"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "QLF — Qualification",
      "gridPos": { "h": 4, "w": 2, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 0.95 }
          ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(benavora_agent_run_duration_seconds_count{family=\"qualification\", status=\"completed\"}[5m])) / sum(rate(benavora_agent_run_duration_seconds_count{family=\"qualification\"}[5m]))"
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "STR — Strategy",
      "gridPos": { "h": 4, "w": 2, "x": 10, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 0.95 }
          ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(benavora_agent_run_duration_seconds_count{family=\"strategy\", status=\"completed\"}[5m])) / sum(rate(benavora_agent_run_duration_seconds_count{family=\"strategy\"}[5m]))"
        }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "KNW — Knowledge Integrity",
      "gridPos": { "h": 4, "w": 2, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 0.95 }
          ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(benavora_agent_run_duration_seconds_count{family=\"knowledge_integrity\", status=\"completed\"}[5m])) / sum(rate(benavora_agent_run_duration_seconds_count{family=\"knowledge_integrity\"}[5m]))"
        }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "OPS — Operations/Eval/Learning",
      "gridPos": { "h": 4, "w": 2, "x": 14, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 0.95 }
          ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(benavora_agent_run_duration_seconds_count{family=\"operations_evaluation_learning\", status=\"completed\"}[5m])) / sum(rate(benavora_agent_run_duration_seconds_count{family=\"operations_evaluation_learning\"}[5m]))"
        }
      ]
    },
    {
      "id": 18,
      "type": "stat",
      "title": "APP — Application",
      "gridPos": { "h": 4, "w": 2, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 0.95 }
          ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(benavora_agent_run_duration_seconds_count{family=\"application\", status=\"completed\"}[5m])) / sum(rate(benavora_agent_run_duration_seconds_count{family=\"application\"}[5m]))"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Success Rate — All Families (trend)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min"] } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{family}}",
          "expr": "sum(rate(benavora_agent_run_duration_seconds_count{family=~\"$family\", status=\"completed\"}[5m])) by (family) / sum(rate(benavora_agent_run_duration_seconds_count{family=~\"$family\"}[5m])) by (family)"
        }
      ]
    },

    { "type": "row", "title": "Agent Run Duration", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }, "id": 2 },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Duration — p50 / p95 / p99 (filtered by $family)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum(rate(benavora_agent_run_duration_seconds_bucket{family=~\"$family\"}[5m])) by (le))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum(rate(benavora_agent_run_duration_seconds_bucket{family=~\"$family\"}[5m])) by (le))"
        },
        {
          "refId": "C",
          "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum(rate(benavora_agent_run_duration_seconds_bucket{family=~\"$family\"}[5m])) by (le))"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "p99 Duration by Family",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{family}}",
          "expr": "histogram_quantile(0.99, sum(rate(benavora_agent_run_duration_seconds_bucket{family=~\"$family\"}[5m])) by (le, family))"
        }
      ]
    },

    { "type": "row", "title": "Dossier Completion", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }, "id": 3 },

    {
      "id": 30,
      "type": "timeseries",
      "title": "Dossier Completion Rate by Fit Level",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{fit_level}}",
          "expr": "sum(rate(benavora_prospect_intelligence_complete_total[1h])) by (fit_level)"
        }
      ]
    },

    { "type": "row", "title": "Failures", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 }, "id": 4 },

    {
      "id": 40,
      "type": "table",
      "title": "Recent Failures by Agent (error rate, 5m)",
      "description": "Backed by benavora_agent_events_total{severity=\"error\"} — set to per-agent error rate, not a log line feed. Wiring an actual log/event stream requires shipping structured logs to Loki (not yet provisioned); see queue-observability-monitoring-REAL.yaml.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          },
          "custom": { "align": "auto", "cellOptions": { "type": "color-background" } }
        }
      },
      "options": { "showHeader": true },
      "transformations": [{ "id": "organize", "options": {} }],
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "sum(rate(benavora_agent_events_total{severity=\"error\"}[5m])) by (agent_id)"
        }
      ]
    }
  ]
}
