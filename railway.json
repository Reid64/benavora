{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "dockerfilePath": "worker/Dockerfile",
    "watchPatterns": [
      "worker/**",
      "package.json",
      "pnpm-lock.yaml",
      "src/lib/autoapply/**",
      "src/lib/supabase/**",
      "src/lib/donor-discovery/**",
      "src/lib/enrichment/web-extractor.ts",
      "src/lib/env.ts",
      "src/types/**"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
