  CREATE TYPE integration_service AS ENUM (
    'sam_gov',
    'two_captcha',
    'candid',
    'gmail',
    'gcal',
    'resend',
    'custom_api'
  );
EXCEPTION WHEN duplicate_object THEN NULL;
