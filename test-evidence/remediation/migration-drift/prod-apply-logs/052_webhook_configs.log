  ) AND NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_schema = 'public' AND table_name = 'webhook_configs' AND column_name = 'type'
  ) THEN
    ALTER TABLE webhook_configs RENAME COLUMN webhook_type TO type;
  END IF;
END $$;
