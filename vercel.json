{
  "functions": {
    "src/app/api/agents/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/ai/**/*.ts": {
      "maxDuration": 300
    },
    "src/app/api/intelligence/reputation/**/*.ts": {
      "maxDuration": 300
    },
    "src/app/api/reports/simulate/**/*.ts": {
      "maxDuration": 300
    },
    "src/app/api/onboarding/complete-setup/**/*.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    { "path": "/api/cron/research", "schedule": "0 6 * * *" },
    { "path": "/api/cron/grantsgov", "schedule": "0 7 * * *" },
    { "path": "/api/cron/reminders", "schedule": "0 8 * * *" },
    { "path": "/api/cron/campaigns", "schedule": "0 */2 * * *" },
    { "path": "/api/cron/autoapply", "schedule": "0 2 * * *" },
    { "path": "/api/cron/domain-warmup", "schedule": "0 6 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
